{
  "compilerOptions": {
    /* Language & runtime */
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020", "DOM"],

    /* Project structure */
    "rootDir": "src",
    "outDir": "build",

    /* Node / Electron compatibility */
    "moduleResolution": "node",
    "esModuleInterop": true,

    /* Type safety */
    "strict": true,
    "skipLibCheck": true,

    /* Debugging */
    "sourceMap": true
  },
  "include": ["src/**/*"]
}
