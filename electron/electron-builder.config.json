{
  "appId": "com.we-online.ProteusConnect",
  "directories": {
    "buildResources": "resources"
  },
  "files": [
    "assets/**/*",
    "build/**/*",
    "app/**/*"
  ],
  "publish": null,
  "win": {
    "icon": "assets/appIcon.ico",
    "target": ["portable"],
    "forceCodeSigning": false,
    "signAndEditExecutable": false
  },
  "linux": {
    "icon": "assets/appIcon.png",
    "target": [
      "AppImage",
      "deb"
    ]
  },
  "mac": {
    "icon": "assets/appIcon.png",
    "target": [
      "dmg",
      "pkg"
    ]
  }
}
